{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Start HostelCare App (Backend + Frontend)",
      "type": "shell",
      "command": "npm start",
      "options": {
        "cwd": "${workspaceFolder}/backend"
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "Start Frontend Server Separately",
      "type": "shell",
      "command": "python -m http.server 8080",
      "options": {
        "cwd": "${workspaceFolder}/frontend"
      },
      "problemMatcher": []
    }
  ]
}
